<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SeniorCalculator" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="FlexCalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="FlexNumberButton" parent="FlexCalcButton">
        <item name="android:backgroundTint">@color/number_bg</item>
        <item name="android:textColor">@color/number_text</item>
    </style>

    <style name="FlexFunctionButton" parent="FlexCalcButton">
        <item name="android:backgroundTint">@color/function_bg</item>
        <item name="android:textColor">@color/function_text</item>
    </style>

    <style name="FlexDivideButton" parent="FlexCalcButton">
        <item name="android:backgroundTint">@color/divide_bg</item>
        <item name="android:textColor">@color/operator_text</item>
    </style>

    <style name="FlexMultiplyButton" parent="FlexCalcButton">
        <item name="android:backgroundTint">@color/multiply_bg</item>
        <item name="android:textColor">@color/operator_text</item>
    </style>

    <style name="FlexSubtractButton" parent="FlexCalcButton">
        <item name="android:backgroundTint">@color/subtract_bg</item>
        <item name="android:textColor">@color/operator_text</item>
    </style>

    <style name="FlexAddButton" parent="FlexCalcButton">
        <item name="android:backgroundTint">@color/add_bg</item>
        <item name="android:textColor">@color/operator_text</item>
    </style>

    <style name="FlexEqualsButton" parent="FlexCalcButton">
        <item name="android:backgroundTint">@color/equals_bg</item>
        <item name="android:textColor">@color/equals_text</item>
    </style>

    <style name="FlexDangerButton" parent="FlexCalcButton">
        <item name="android:backgroundTint">@color/danger_bg</item>
        <item name="android:textColor">@color/danger_text</item>
    </style>

</resources>
